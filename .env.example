# --- Supabase ---
# Project Settings > API. A URL e a anon/publishable key são públicas
# (o navegador as usa; a proteção real é a RLS). NÃO comite valores reais:
# copie este arquivo para .env.local e preencha lá (.env.local é git-ignored).
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"

# SECRETA — bypassa RLS. Só no servidor. NUNCA prefixe com NEXT_PUBLIC_
# e NUNCA cole no navegador. (Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# --- Mercado Pago (a partir do M3 — pagamento Pix) ---
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_WEBHOOK_SECRET=""
